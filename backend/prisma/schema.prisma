generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  wheels Wheel[]
  movies Movie[]
  genres Genre[]
}

// Каталог жанрів користувача — джерело для вибору чипсами у формі фільму.
// Самі фільми зберігають жанри рядками (Movie.genres); перейменування/видалення
// запису тут каскадно синхронізується з цими рядками у сервісі.
model Genre {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

// Бібліотека фільмів користувача. Незалежна від коліс — один фільм можна
// класти в будь-яке колесо через WheelItem.
model Movie {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  imdbRating  Float?
  // Постер: зовнішній URL або шлях до завантаженого файлу (/uploads/...).
  posterUrl   String?
  year        Int?
  genres      String[] @default([])
  // Перегляд
  watched     Boolean  @default(false)
  watchedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WheelItem[]
  wins  SpinHistory[]

  @@index([userId])
}

model Wheel {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WheelItem[]
  spins SpinHistory[]

  @@index([userId])
}

// Фільм у конкретному колесі + його вага (шанс пропорційний вазі).
model WheelItem {
  id        String   @id @default(cuid())
  wheelId   String
  movieId   String
  weight    Float    @default(1)
  createdAt DateTime @default(now())

  wheel Wheel @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([wheelId, movieId])
  @@index([wheelId])
}

model SpinHistory {
  id        String   @id @default(cuid())
  wheelId   String
  movieId   String
  createdAt DateTime @default(now())

  wheel Wheel @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([wheelId])
}
