generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  // Токен публічного посилання на бібліотеку («Поділитися»). null — посилання
  // не створене або відкликане; будь-хто з токеном бачить список лише на читання.
  shareToken   String?  @unique
  createdAt    DateTime @default(now())

  wheels Wheel[]
  movies Movie[]
  genres Genre[]
  suggestionSessions SuggestionSession[]
}

// Каталог жанрів користувача — джерело для вибору чипсами у формі фільму.
// Самі фільми зберігають жанри рядками (Movie.genres); перейменування/видалення
// запису тут каскадно синхронізується з цими рядками у сервісі.
model Genre {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

// Бібліотека фільмів користувача. Незалежна від коліс — один фільм можна
// класти в будь-яке колесо через WheelItem.
model Movie {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  imdbRating  Float?
  // Постер: зовнішній URL або шлях до завантаженого файлу (/uploads/...).
  posterUrl   String?
  year        Int?
  genres      String[] @default([])
  // Своє слово, додане прямо на сторінці колеса: у бібліотеці «Мої фільми»
  // не показується, живе лише як позиція колеса.
  isCustom    Boolean  @default(false)
  // Перегляд
  watched     Boolean  @default(false)
  watchedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       WheelItem[]
  wins        SpinHistory[]
  suggestions Suggestion[]

  @@index([userId])
}

model Wheel {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    WheelItem[]
  spins    SpinHistory[]
  sessions SuggestionSession[]

  @@index([userId])
}

// Фільм у конкретному колесі + його вага (шанс пропорційний вазі).
model WheelItem {
  id        String   @id @default(cuid())
  wheelId   String
  movieId   String
  weight    Float    @default(1)
  createdAt DateTime @default(now())

  wheel Wheel @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([wheelId, movieId])
  @@index([wheelId])
}

model SpinHistory {
  id        String   @id @default(cuid())
  wheelId   String
  movieId   String
  createdAt DateTime @default(now())

  wheel Wheel @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([wheelId])
}

// Сесія пропонування фільмів. Власник відкриває її поверх публічного посилання
// й вибирає колесо, в яке падатимуть пропозиції гостей. Активна сесія
// (closedAt = null) у користувача одна — старт нової закриває попередню.
// Закриті сесії лишаємо: колесо вже набране, а історія «хто що пропонував»
// нікому не заважає.
model SuggestionSession {
  id       String    @id @default(cuid())
  userId   String
  wheelId  String
  // Налаштування сесії (питати ім'я гостя тощо) — одним Json-полем, а не
  // окремими колонками: нову опцію можна додати без міграції. Форма опцій
  // описана типом SessionOptions у suggestions/session-options.ts, звідти ж
  // єдина нормалізація з дефолтами.
  options  Json      @default("{}")
  closedAt DateTime?
  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wheel       Wheel        @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  suggestions Suggestion[]

  @@index([userId])
}

// Один запропонований гостем фільм. Живе окремо від WheelItem, бо позиції
// колеса власник може міняти руками, а нам треба знати саме те, що прийшло
// по посиланню — для позначки на картці й фільтра «Запропоновані».
model Suggestion {
  id        String   @id @default(cuid())
  sessionId String
  movieId   String
  // Ім'я гостя, якщо сесія його питала; інакше null.
  guestName String?
  createdAt DateTime @default(now())

  session SuggestionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  movie   Movie             @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([sessionId, movieId])
  @@index([sessionId])
}
