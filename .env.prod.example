# Приклад продакшн-змінних для docker-compose.prod.yml.
# Скопіюй у файл .env поряд і заповни своїми значеннями:  cp .env.prod.example .env

# --- Postgres ---
POSTGRES_USER=spin
POSTGRES_PASSWORD=ЗМІНИ_НА_СИЛЬНИЙ_ПАРОЛЬ
POSTGRES_DB=spin

# --- Бекенд ---
# Довгий випадковий рядок, напр.:  openssl rand -hex 32
JWT_SECRET=ЗМІНИ_НА_ДОВГИЙ_ВИПАДКОВИЙ_РЯДОК
JWT_EXPIRES_IN=7d
# Домен фронту (для CORS). При роздачі фронта й API з одного домену через nginx
# CORS фактично не задіяний — можна лишити свій домен або *.
CORS_ORIGIN=https://your-domain.com

# --- Публічний порт nginx на хості ---
WEB_PORT=80
